ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Solo bootstrap. NO copiar el token que sigue usando Apps Script.
ML_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
MIRROR_SHEET_ID=
# ID numérico de la pestaña (gid), no del documento. Crear la pestaña antes.
MIRROR_TAB_ID=0
# Solo para npm run migrate; no es necesario en los cron.
DATABASE_URL=
TASK=incremental
ML_GET_CONCURRENCY=20
ML_PUT_DELAY_MS=350
# false permite comparar sin enviar PUT durante la transición.
PUSH_ENABLED=false
